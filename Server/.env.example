# Copia este archivo como .env y completa los valores

NODE_ENV=development
PORT=4000

# Base de datos MongoDB (local o MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/nova_salud

# Clave para firmar los tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esta-clave-secreta

# URL(s) del frontend desplegado, separadas por coma (CORS)
FRONTEND_URL=http://localhost:5173

# Cloudinary: almacenamiento de imágenes de productos, categorías y avatares
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Asistente virtual (chatbot) con Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Búsqueda semántica de productos (embeddings): Gemini u OpenAI (opcional)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Pago con tarjeta mediante Paymob (opcional; el pago contra entrega funciona sin esto)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_CURRENCY=EGP
